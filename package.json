{
  "name": "raycast",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Vertical 2.5D raycasting engine with AI-friendly multi-directional sprite pipeline",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "playtest": "tsx tools/playtest/run.ts",
    "playtest:matrix": "tsx tools/playtest/matrix.ts",
    "mcp:studio": "tsx tools/mcp/studio.ts",
    "assets:textures": "tsx tools/assets/make-textures.ts",
    "assets:blender": "bash tools/blender/render-all.sh",
    "assets:stylize": "tsx tools/stylize/pixel-art.ts",
    "assets:comfy": "tsx tools/stylize/comfy.ts",
    "assets:comfy:dry": "tsx tools/stylize/comfy.ts --dry-run",
    "assets:verify": "tsx tools/verify/style.ts",
    "assets:atlas": "tsx tools/atlas/pack.ts",
    "assets": "npm run assets:textures && npm run assets:blender && npm run assets:stylize && npm run assets:atlas"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "pngjs": "^7.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
